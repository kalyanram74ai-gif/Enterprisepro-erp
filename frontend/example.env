# Copy this file to .env (or .env.local) and adjust as needed.
#
# Leave unset (or use the default below) during local development —
# vite.config.js already proxies /api to http://localhost:8080.
#
# Only set this explicitly in production, and point it at the real
# backend origin. Pointing it at the wrong host/port is a common cause
# of "Unexpected token '<' ... is not valid JSON" errors, since the
# frontend will receive HTML (its own index.html, or a proxy/CDN error
# page) instead of the expected JSON API response.
VITE_API_URL=/api
